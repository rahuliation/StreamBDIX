else
  export NODE_PATH="/Users/rahul/Desktop/personal/StreamBDIX/node_modules/.pnpm/stremio-addon-sdk@1.6.10/node_modules/stremio-addon-sdk/cli/node_modules:/Users/rahul/Desktop/personal/StreamBDIX/node_modules/.pnpm/stremio-addon-sdk@1.6.10/node_modules/stremio-addon-sdk/node_modules:/Users/rahul/Desktop/personal/StreamBDIX/node_modules/.pnpm/stremio-addon-sdk@1.6.10/node_modules:/Users/rahul/Desktop/personal/StreamBDIX/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../cli/bootstrap.js" "$@"
else
  exec node  "$basedir/../../cli/bootstrap.js" "$@"
fi
